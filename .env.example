# ─────────────────────────────────────────────────────────────────────────────
# CodeVerse configuration
# Copy to .env.local and adjust. Every variable is optional.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub personal access token (classic or fine-grained, public-repo read only).
# Server-side only: it is never sent to the browser and never logged.
# Without it, GitHub allows 60 API requests/hour per server IP; with it, 5,000.
# Without a token a server can analyse only a handful of new repositories per
# hour; cached analyses keep being served when the quota runs out. Page
# metadata and social images stop calling GitHub once half of the quota is used.
# A token also enables GraphQL-powered history (per-file activity, full timeline).
GITHUB_TOKEN=

# Public URL of this deployment, used for absolute Open Graph/share links.
# Defaults: the Vercel production domain on Vercel, https://codeverse.awab.tech in other
# production builds, http://localhost:3000 in development. Set it when self-hosting.
# NEXT_PUBLIC_SITE_URL=https://codeverse.example.com

# Link shown in the UI for the project's own source code.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/tedddby/CodeVerse

# ── Analysis limits (defaults shown) ─────────────────────────────────────────
# Maximum tree entries (files) kept as nodes in the 3D world.
# CODEVERSE_MAX_FILES=25000
# Maximum number of files whose contents are downloaded and parsed.
# CODEVERSE_MAX_PARSED_FILES=1500
# Maximum size of a single file to download/parse (bytes).
# CODEVERSE_MAX_FILE_BYTES=524288
# Maximum total bytes downloaded per analysis.
# CODEVERSE_MAX_TOTAL_BYTES=41943040
# Files larger than this are counted but not AST-parsed (bytes).
# CODEVERSE_MAX_PARSE_BYTES=262144
# Per-file parse timeout (milliseconds).
# CODEVERSE_PARSE_TIMEOUT_MS=2000
# Concurrent file downloads.
# CODEVERSE_FETCH_CONCURRENCY=16
# Commits listed / commits whose changed-file lists are fetched.
# Without a GITHUB_TOKEN these are capped at 100 / 6 to conserve the 60 requests/hour quota.
# CODEVERSE_MAX_COMMITS=300
# CODEVERSE_MAX_COMMIT_DETAILS=40

# ── Large repository tiers (file counts) ─────────────────────────────────────
# Below FULL: everything eligible is parsed. Between: progressive. Above DIRECTORY_FIRST: directory-first.
# CODEVERSE_TIER_FULL_MAX=1000
# CODEVERSE_TIER_PROGRESSIVE_MAX=10000

# ── Caching ──────────────────────────────────────────────────────────────────
# In-memory cache size for analysed graphs (megabytes).
# CODEVERSE_CACHE_MAX_MB=256
# Optional directory for a persistent on-disk graph cache (no source code is stored).
# CODEVERSE_CACHE_DIR=.codeverse-cache

# ── Abuse protection ─────────────────────────────────────────────────────────
# Analyses allowed per client IP per minute (0 disables the limiter).
# CODEVERSE_RATE_LIMIT_PER_MINUTE=12
# Client IPs for rate limiting come from X-Forwarded-For. Clients can put
# anything at the left of that list, so the address is read this many entries
# from the right: the number of reverse proxies in front of the server that
# append to the header (nginx with $proxy_add_x_forwarded_for, a cloud load
# balancer, Vercel: 1). Next.js only fills the header when it is missing, so
# always deploy behind a proxy.
# CODEVERSE_TRUSTED_PROXY_HOPS=1
# Alternatively, a header your platform overwrites with the client address on
# every request (e.g. x-real-ip with nginx "proxy_set_header X-Real-IP $remote_addr").
# CODEVERSE_CLIENT_IP_HEADER=
# Analyses running at the same time on one server instance.
# CODEVERSE_MAX_CONCURRENT_ANALYSES=4

# ── Observability ────────────────────────────────────────────────────────────
# Structured log level: debug | info | warn | error | silent
# CODEVERSE_LOG_LEVEL=info
# Metrics sink: log (debug-level log lines, default) | info | off
# CODEVERSE_METRICS=log

# ── Assets ───────────────────────────────────────────────────────────────────
# Directory containing the tree-sitter .wasm grammars when public/grammars is
# not next to the server's working directory (e.g. custom Docker layouts).
# CODEVERSE_GRAMMAR_DIR=
# Font for in-world 3D labels (.ttf/.otf/.woff). Defaults to the bundled Geist Mono.
# NEXT_PUBLIC_LABEL_FONT_URL=/fonts/GeistMono-Medium.ttf
